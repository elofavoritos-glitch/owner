# Supabase (crie o projeto em supabase.com e copie as chaves do painel)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Login Microsoft 365 (reaproveita o app registration do Entra já criado)
# Configure o provider "Azure" no Supabase Auth com estes valores.
MS_TENANT_ID=3073b3c6-...        # mesmo tenant da ELO
MS_CLIENT_ID=f69a22c5-...        # pode ser o mesmo app ou um dedicado ao web app
MS_CLIENT_SECRET=defina-no-supabase-nao-no-repo

# Assistente comercial (chat) — Groq (API compatível com OpenAI)
# Crie a chave GRATUITA em console.groq.com/keys e configure como Secret na Vercel.
# Sem ela, o chat entra em "modo demonstração" (cálculo determinístico, sem
# conversa livre). Opcional: GROQ_MODEL (default llama-3.3-70b-versatile).
GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# Nunca comitar o .env real. Em produção, use variáveis do provedor (Vercel/Azure).
