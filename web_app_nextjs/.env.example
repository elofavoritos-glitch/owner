# Supabase (crie o projeto em supabase.com e copie as chaves do painel)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Login Microsoft 365 (reaproveita o app registration do Entra já criado)
# Configure o provider "Azure" no Supabase Auth com estes valores.
MS_TENANT_ID=3073b3c6-...        # mesmo tenant da ELO
MS_CLIENT_ID=f69a22c5-...        # pode ser o mesmo app ou um dedicado ao web app
MS_CLIENT_SECRET=defina-no-supabase-nao-no-repo

# Assistente comercial (chat) — Groq (API compatível com OpenAI)
# Crie a chave GRATUITA em console.groq.com/keys e configure como Secret na Vercel.
# Sem ela, o chat entra em "modo demonstração" (cálculo determinístico, sem
# conversa livre). Opcional: GROQ_MODEL (default openai/gpt-oss-20b, disponível
# no free tier e com suporte a ferramentas). Veja console.groq.com/docs/models.
GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo  # modelo de transcrição de voz (ditado)

# Voz do assistente (text-to-speech natural PT-BR) — Google Cloud TTS.
# Crie uma API key em console.cloud.google.com (habilite "Cloud Text-to-Speech
# API"). Free tier: ~1 milhão de caracteres/mês. Sem ela, a fala cai para o TTS
# do navegador (robótico). Opcional: GOOGLE_TTS_VOICE (default pt-BR-Neural2-B).
GOOGLE_TTS_API_KEY=
# GOOGLE_TTS_VOICE=pt-BR-Neural2-B

# Nunca comitar o .env real. Em produção, use variáveis do provedor (Vercel/Azure).

# Rotas/distância do assistente (OpenRouteService). Chave gratuita em
# openrouteservice.org. Sem ela, o cálculo de rotas fica indisponível.
ELO_ORS_API_KEY=

# Inteligência de comércio exterior (Logcomex NCM Intel). Chave da conta ELO.
# Requer o produto "ncm-intel" ativado na conta. Sem ela, a consulta por NCM
# fica indisponível no assistente.
ELO_LOGCOMEX_API_KEY=

# Inteligência de empresas (Econodata API v4). Chave no formato ek_live_...
# Gere em plat.econodata.com.br (Chaves e Integrações) — requer API v4 liberada
# na conta. Habilita prospecção, dimensionamento de mercado, enriquecimento de
# empresa, match por nome+UF e mapa de decisores no assistente. Cobrança em
# tokens. Sem ela, as consultas Econodata ficam indisponíveis.
ELO_ECONODATA_API_KEY=

# Integração SharePoint → base de conhecimento do assistente (Microsoft Graph,
# app-only). App registration dedicado no Entra com permissão Sites.Read.All +
# consentimento de admin. Veja SHAREPOINT_GRAPH.md. Sem isso, a sincronização de
# procedimentos comerciais fica indisponível (o resto do assistente funciona).
ELO_GRAPH_TENANT_ID=
ELO_GRAPH_CLIENT_ID=
ELO_GRAPH_CLIENT_SECRET=
ELO_SHAREPOINT_HOST=intranetelo.sharepoint.com
ELO_SHAREPOINT_SITE_PATH=/sites/DEPARTAMENTOS

# Integração com o Senior Gestão Empresarial | ERP (Plataforma Senior X / Cloud).
# Autenticação servidor-a-servidor via Chave de Aplicação (loginWithKey): a
# plataforma devolve um token usado no header Authorization das chamadas.
# Crie a Chave de Aplicação na Plataforma Senior X (acesso de serviços terceiros)
# e informe os valores apenas por variável de ambiente (nunca no repo).
# O path de autenticação pode variar por tenant; ajuste SENIOR_AUTH_PATH se o
# smoke test (scripts/testar-senior.mjs) retornar 404. Sem essas variáveis, a
# integração com o ERP fica indisponível (o resto do assistente funciona).
SENIOR_ACCESS_KEY=
SENIOR_SECRET=
SENIOR_TENANT=suaempresa.com.br
# SENIOR_API_BASE_URL=https://api.senior.com.br
# SENIOR_AUTH_PATH=/platform/authentication/actions/loginWithKey
